# syntax=docker/dockerfile:1

FROM composer:2 AS vendor

WORKDIR /app

COPY composer.json composer.lock ./
RUN composer install --no-dev --no-scripts --prefer-dist --no-autoloader

COPY . .
RUN mkdir -p storage/framework/cache/data storage/framework/sessions storage/framework/views storage/logs bootstrap/cache \
    && composer install --no-dev --optimize-autoloader --no-interaction

FROM node:22-alpine AS frontend

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts

COPY vite.config.js ./
COPY resources ./resources
COPY public ./public
COPY --from=vendor /app/vendor ./vendor
COPY --from=vendor /app/bootstrap ./bootstrap
COPY --from=vendor /app/config ./config
COPY --from=vendor /app/artisan ./artisan

RUN npm run build

FROM php:8.4-fpm-bullseye AS php

WORKDIR /var/www/html

RUN apt-get update && apt-get install -y \
    git \
    bash \
    zip \
    unzip \
    libzip-dev \
    libxml2-dev \
    pkg-config \
    libssl-dev \
    zlib1g-dev \
    g++ \
    make \
    autoconf \
    && docker-php-ext-install pdo pdo_mysql zip pcntl \
    && pecl install redis \
    && docker-php-ext-enable redis \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

COPY --from=frontend /app /var/www/html

RUN mkdir -p storage/framework/{cache,sessions,views} storage/logs bootstrap/cache \
    && chown -R www-data:www-data storage bootstrap/cache

USER www-data

EXPOSE 9000
CMD ["php-fpm"]

FROM nginx:1.25-alpine AS nginx

COPY docker/nginx/prod-init.conf /etc/nginx/conf.d/default.conf
COPY --from=php /var/www/html/public /var/www/html/public

EXPOSE 80 443